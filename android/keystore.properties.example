# Copy this file to `keystore.properties` (same folder) and fill in real values.
# keystore.properties is gitignored — NEVER commit it or the .jks/.keystore file.
#
# 1. Generate an upload keystore (once), keep the .jks file somewhere safe & backed up:
#    keytool -genkey -v -keystore ninja-piano-upload.jks -keyalg RSA -keysize 2048 \
#            -validity 10000 -alias upload
#
# 2. Point storeFile at it (path relative to the android/ folder, or absolute).

storeFile=../ninja-piano-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
